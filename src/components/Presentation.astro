---
    import { Icon } from 'astro-icon/components'
    import StickyCard from './ui/StickyCard.astro'
    import AnimatedArrowDown from './ui/AnimatedArrowDown.astro'
---

<StickyCard>
    <h1 class="title font-sans">
        Mi nombre es
        <br>
        <span class="title-accent">Elder Estrada.</span></h1>
    <p class="description">Desarrollador Web Fullstack en crecimiento.</p>

    <div class="social-links">
        <a href="https://github.com/quamtumcoderin" target="_blank" class="social-link">
            <Icon name="github" /> GitHub
        </a>
        <a href="https://google.com/" target="_blank" class="social-link">
            <Icon name="linkedin" /> LinkedIn
        </a>
        <a href="https://google.com/" target="_blank" class="social-link">
            <Icon name="filetype-pdf" /> Curriculum
        </a>
    </div>

    <AnimatedArrowDown />
</StickyCard>

<style>
    .title {
        font-size: 6rem;
        font-weight: 900;
    }

    .title-accent {
        color: var(--primary);
    }

    .description {
        font-size: 1.3rem;
        color: var(--on-surface-variant);
        padding: 0 4px;
    }

    .social-links {
        display: flex;
        gap: 1.5rem;
        align-items: center;
        padding: 1rem 4px;
    }

    .social-link {
        position: relative;
        padding: .8rem 1.4rem;
        font-weight: 700;
        color: var(--surface-high);
        text-decoration: none;
        background: var(--primary);
        border: 2px solid var(--border-primary);
        border-radius: 1.5rem;
        box-shadow: 0 10px var(--primary);

        transition: transform 0.08s ease, box-shadow 0.08s ease;
    }

    .social-link:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px var(--primary);
    }

    .social-link:active {
        transform: translateY(10px);
        box-shadow: 0 2px var(--primary);
    }
</style>